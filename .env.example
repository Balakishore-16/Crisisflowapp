# ═══════════════════════════════════════════════════════════
# CrisisFlow Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your credentials.
# The app works WITHOUT any of these — local simulation mode is default.

# ─── Operational Database ───
DATABASE_URL=sqlite:///./crisisflow.db
FABRIC_SQL_CONNECTION_STRING=

# ─── External Public & Sensor APIs ───
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OSRM_BASE_URL=https://router.project-osrm.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
RAINVIEWER_BASE_URL=https://api.rainviewer.com
AQICN_API_KEY=
USGS_BASE_URL=https://earthquake.usgs.gov/fdsnws/event/1

# ─── Microsoft Fabric — Eventstream (Event Hub compatible) ───
FABRIC_EVENTHUB_CONNECTION_STRING=
FABRIC_EVENTHUB_NAME=

# ─── Microsoft Fabric — Eventhouse / KQL ───
FABRIC_EVENTHOUSE_ENDPOINT=
FABRIC_KQL_DATABASE=

# ─── Microsoft Fabric — OneLake / Lakehouse ───
FABRIC_ENDPOINT=
FABRIC_WORKSPACE_ID=
FABRIC_LAKEHOUSE_ID=
FABRIC_TOKEN=

# ─── Azure AI / OpenAI ───
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ─── Azure Maps ───
AZURE_MAPS_KEY=

# ─── Microsoft Entra ID ───
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
