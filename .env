# ═══════════════════════════════════════════════════════════
# CrisisFlow Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your credentials.
# The app works WITHOUT any of these — local simulation mode is default.

# ─── Database ───
DATABASE_URL=sqlite:///./crisisflow.db

# ─── Microsoft Fabric — Eventstream (Event Hub compatible) ───
FABRIC_EVENTHUB_CONNECTION_STRING=
FABRIC_EVENTHUB_NAME=

# ─── Microsoft Fabric — Eventhouse / KQL ───
FABRIC_EVENTHOUSE_ENDPOINT=
FABRIC_KQL_DATABASE=

# ─── Microsoft Fabric — OneLake / Lakehouse ───
FABRIC_ENDPOINT=https://api.fabric.microsoft.com/v1
FABRIC_WORKSPACE_ID=6fc9c074-d357-4bd9-aa8d-23f2ebb7ea95
FABRIC_LAKEHOUSE_ID=
FABRIC_TOKEN=

# ─── Microsoft Entra ID ───
AZURE_CLIENT_ID=
AZURE_TENANT_ID=8ba02f42-a433-4ad5-bdab-0103a1bc5fa5

# ─── Azure AI / OpenAI ───
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ─── Azure Maps ───
AZURE_MAPS_KEY=

# ─── Microsoft Entra ID ───
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
